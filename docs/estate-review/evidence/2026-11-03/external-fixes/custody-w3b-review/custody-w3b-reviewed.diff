+    if event.kind == 22242 {
+        let tag = |name: &str| {
+            event
+                .tags
+                .iter()
+                .find(|t| t.first().is_some_and(|v| v == name))
+                .and_then(|t| t.get(1))
+        };
+        return Ok((
+            "nip42_auth",
+            json!({"key":key,"relay":tag("relay"),"challenge":tag("challenge")}),
+        ));
+    }
+    let op = if key == "agent_governance" {
+        "governance_event"
+    } else {
+        "forum_event"
+    };
+    Ok((
+        op,
+        json!({"key":key,"kind":event.kind,"tags":event.tags,"content":event.content}),
+    ))
+}
