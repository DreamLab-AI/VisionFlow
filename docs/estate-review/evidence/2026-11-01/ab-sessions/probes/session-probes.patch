+#[test]
+fn audit_directory_drift_hits_branch_guard_before_kill() {
+    let fx = Fx::new(sleeper(), &format!("{A}worktree = true\n"));
+    let p = fx.plane();
+    assert_eq!(decision(&p.reconcile_once(false), "a"), Decision::Create);
+    let old_dir = fx.home.join("workspace/wt/aoe-a");
+    std::fs::write(old_dir.join("work-in-progress.txt"), "synthetic work").unwrap();
+    assert!(!agentbox_sessions::worktree::dirty(&old_dir).unwrap().is_empty());
+    let path = fx.root.join("config/session-plane/launch.json");
+    let mut contract: Value = serde_json::from_str(&std::fs::read_to_string(&path).unwrap()).unwrap();
+    contract["worktree_prefix"] = json!("moved-");
+    std::fs::write(path, contract.to_string()).unwrap();
+    let next = fx.plane();
+    let out = next.reconcile_once(false);
+    assert_eq!(out[0].decision,Some(Decision::Recreate(Reason::Drifted)));
+    assert!(out[0].error.as_deref().unwrap().contains("already used by worktree"));
+    let pane = next.tmux.list().unwrap().into_iter().find(|p| p.name == "abs_a").unwrap();
+    assert!(pane.path.ends_with("/aoe-a"));
+    assert!(old_dir.join("work-in-progress.txt").exists(), "branch registration blocks replacement before the old process is killed");
+}
