+#[test]
+fn audit_send_reports_failure_after_text_was_submitted() {
+    let fx = Fx::new(json!({"claude":{"argv":["cat"]}}), "[[interaction_plane.session_seeds]]\nslug=\"a\"\ntool=\"claude\"\n");
+    let p = fx.plane();
+    assert_eq!(decision(&p.reconcile_once(false),"a"),Decision::Create);
+    std::fs::write(fx.root.join("hooks"),"synthetic filesystem obstruction").unwrap();
+    let result=api::dispatch(&p,r#"{"op":"send","slug":"a","text":"audit-submitted"}"#);
+    assert_eq!(result["ok"],false);
+    wait_for("submitted text despite failed reply",5,||pane_text(&p,"abs_a").matches("audit-submitted").count()>=2);
+}
