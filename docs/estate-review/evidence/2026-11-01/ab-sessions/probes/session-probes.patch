+#[test]
+fn audit_removed_seed_survives_reload_and_cannot_be_closed() {
+    let fx=Fx::new(sleeper(),A);
+    let p=fx.plane();
+    assert_eq!(decision(&p.reconcile_once(false),"a"),Decision::Create);
+    std::fs::write(fx.root.join("agentbox.toml"),"[interaction_plane]\nenabled=true\n").unwrap();
+    assert_eq!(decision(&p.reconcile_once(false),"a"),Decision::Keep,"existing instance does not reload manifest");
+    let next=fx.plane();
+    assert!(next.reconcile_once(false).is_empty());
+    let row=next.status().unwrap().into_iter().find(|r|r.slug=="a").unwrap();
+    assert!(row.present && row.origin=="seed");
+    assert!(next.close("a").unwrap_err().to_string().contains("no api-created session"));
+}
