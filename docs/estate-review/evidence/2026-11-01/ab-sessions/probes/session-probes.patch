+#[test]
+fn audit_git_status_error_is_treated_as_clean_for_restart() {
+    let fx = Fx::new(sleeper(), &format!("{A}worktree = true\n"));
+    let p = fx.plane();
+    assert_eq!(decision(&p.reconcile_once(false), "a"), Decision::Create);
+    let dir = fx.home.join("workspace/wt/aoe-a");
+    std::fs::write(dir.join("work-in-progress.txt"), "synthetic work").unwrap();
+    std::fs::write(dir.join(".git"), "broken synthetic git pointer\n").unwrap();
+    assert!(agentbox_sessions::worktree::dirty(&dir).is_err());
+    fx.tmux(&["set-option", "-t", "=abs_a:", "@agentbox-fp", "stale"]);
+    assert_eq!(decision(&p.reconcile_once(false), "a"), Decision::Recreate(Reason::Drifted));
+    assert!(dir.join("work-in-progress.txt").exists());
+}
