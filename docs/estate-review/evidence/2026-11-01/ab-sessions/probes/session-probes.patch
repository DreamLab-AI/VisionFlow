+#[test]
+fn audit_api_session_is_listed_blocked_but_send_ignores_tool_blocker() {
+    let fx = Fx::new(json!({"signin":{"argv":["sh","-c","printf 'LOGIN_GATE\\n'; cat"],"blockers":["LOGIN_GATE"]}}), "");
+    let p = fx.plane();
+    p.create(&CreateReq{slug:"scratch".into(),tool:"signin".into(),model:None,worktree:false}).unwrap();
+    wait_for("synthetic prompt",5,||pane_text(&p,"abs_scratch").contains("LOGIN_GATE"));
+    assert!(matches!(p.status().unwrap().into_iter().find(|r|r.slug=="scratch").unwrap().state,State::Blocked(_)));
+    p.send("scratch","audit-input").unwrap();
+    wait_for("input consumed despite blocked status",5,||pane_text(&p,"abs_scratch").matches("audit-input").count()>=2);
+}
