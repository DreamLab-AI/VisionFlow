+#[test]
+fn audit_switch_to_shared_directory_bypasses_old_worktree_guard() {
+ let fx=Fx::new(sleeper(),&format!("{A}worktree = true\n"));
+ let p=fx.plane();
+ assert_eq!(decision(&p.reconcile_once(false),"a"),Decision::Create);
+ let old=fx.home.join("workspace/wt/aoe-a");
+ std::fs::write(old.join("work-in-progress.txt"),"synthetic work").unwrap();
+ std::fs::write(fx.root.join("agentbox.toml"),format!("[interaction_plane]\nenabled=true\n{A}worktree=false\n")).unwrap();
+ let next=fx.plane();
+ assert_eq!(decision(&next.reconcile_once(false),"a"),Decision::Recreate(Reason::Drifted));
+ assert!(next.tmux.list().unwrap().into_iter().find(|p|p.name=="abs_a").unwrap().path.ends_with("/workspace/project"));
+ assert!(old.join("work-in-progress.txt").exists());
+}
