+#[test]
+fn audit_api_worktree_is_reported_false_and_left_after_close() {
+    let fx=Fx::new(sleeper(),"");
+    let p=fx.plane();
+    p.create(&CreateReq{slug:"scratch".into(),tool:"sleeper".into(),model:None,worktree:true}).unwrap();
+    let dir=fx.home.join("workspace/wt/aoe-scratch");
+    assert!(dir.join(".git").exists());
+    assert!(!p.status().unwrap().into_iter().find(|r|r.slug=="scratch").unwrap().worktree);
+    p.close("scratch").unwrap();
+    assert!(dir.join(".git").exists());
+    assert!(agentbox_sessions::worktree::registered(&fx.home.join("workspace/project")).unwrap().iter().any(|(path,_)|path==&dir));
+}
