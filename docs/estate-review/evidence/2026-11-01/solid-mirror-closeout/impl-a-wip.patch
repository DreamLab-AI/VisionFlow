+/// A full SHA-1 or SHA-256 object id (lowercase hex).
+fn is_full_object_id(rev: &str) -> bool {
+    matches!(rev.len(), 40 | 64)
+        && rev
+            .bytes()
+            .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
