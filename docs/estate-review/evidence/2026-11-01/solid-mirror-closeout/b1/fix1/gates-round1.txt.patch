+    let j: serde_json::Value = serde_json::from_slice(&journal.expect("a gate journal")).unwrap();
+    assert_eq!(j["state"], "failed", "{j}");
+    assert_eq!(j["attempts"], 0, "{j}");
+    let reason = j["reason"].as_str().unwrap_or("");
