+    let raw = format!(
+        "tree {tree}\nparent {}\nauthor t <t@t> 1700000000 +99999\ncommitter t <t@t> 1700000000 +0000\n\nb1 bad zone\n",
+        fx.m2
+    );
+    let mut child = Command::new("git")
+        .args([
+            "hash-object",
