+            let fetched = Arc::new(tokio::sync::Notify::new());
+            let git = Arc::new(ParkAfterFetch {
+                inner: GitCli::new(home.join("repos")),
+                armed: std::sync::atomic::AtomicBool::new(false),
+                fetched: fetched.clone(),
+            });
+            let m = Arc::new(Mirror::with_parts(
+                quiet_cfg(&entry),
