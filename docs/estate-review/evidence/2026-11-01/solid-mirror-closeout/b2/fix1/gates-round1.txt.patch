+/// Design test 7: a fork of a fork (transitive) is rebuilt (C2).
+#[tokio::test]
+async fn b2_t7_a_fork_of_a_fork_is_rebuilt() {
+    let fx = legacy(191, Shape::Engine);
+    let first = make_fork(&fx.plugin, &fx.owner, "carol").await;
