+            let spy = Arc::new(Spy {
+                inner: GitCli::new(plugin.join("repos")),
+                prepares: std::sync::atomic::AtomicU32::new(0),
+                time_out,
+            });
+            let m = Arc::new(Mirror::with_parts(
+                quiet_cfg(entry),
+                MirrorStore::new(plugin),
+                spy.clone(),
+                Arc::new(SystemClock),
+                Arc::new(AllowAll),
+            ));
+            (m, spy)
+        }
