+        async fn until_main_is(p: &Published, want: &str, what: &str) {
+            let served = p.served();
+            let home = p.home().to_path_buf();
+            until(what, || {
+                let main = rev(&served, &home, "refs/heads/main");
+                let ok = main == want;
+                async move { ok.then_some(()) }
+            })
+            .await;
+        }
