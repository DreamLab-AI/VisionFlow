+                let r = store
+                    .read(&p.owner, "sample")
+                    .filter(|r| r.last_event.as_ref().is_some_and(|e| e.id == ev.id));
+                async move { r }
+            })
+            .await;
+            assert_eq!(done.failures, 0);
+            assert_eq!(done.last_fetch.map(|f| f.moved), Some(1));
+        }
